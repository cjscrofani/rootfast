{
  "name": "rootfast-api",
  "version": "0.0.1",
  "private": true,
  "description": "Cloudflare Worker that serves the Rootfast API from D1",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:create": "wrangler d1 create rootfast",
    "db:apply:local": "wrangler d1 migrations apply rootfast --local",
    "db:apply:remote": "wrangler d1 migrations apply rootfast --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240725.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.9",
    "wrangler": "^4.95.0"
  }
}
