---
import type { Plant } from '@/lib/api';

export interface Props {
  plant: Plant;
}
const { plant } = Astro.props;

/* Split USDA's scientific_name into (binomial italic) + (authority normal).
   USDA gives names like "Pinus ponderosa Lawson & C. Lawson var. scopulorum Engelm."
   We render the binomial / trinomial in italic, and the authorities and rank
   markers in upright type, like a botanical key.                              */
function renderName(sci: string) {
  // Tokenize, italicize the "name" tokens, leave rank markers + authorities upright.
  const RANK_MARKERS = new Set(['var.', 'ssp.', 'subsp.', 'f.']);
  const tokens = sci.split(/\s+/);
  const out: { italic: boolean; text: string }[] = [];
  let italicCount = 0; // first two italic tokens = the binomial
  for (const t of tokens) {
    if (RANK_MARKERS.has(t)) {
      out.push({ italic: false, text: ' ' + t + ' ' });
      italicCount = 0; // next single token after marker is italic (the epithet)
    } else if (italicCount < 2) {
      out.push({ italic: true, text: (out.length ? ' ' : '') + t });
      italicCount++;
    } else if (italicCount === 2 && out.length > 0 && !out[out.length - 1]!.italic
               && out[out.length - 1]!.text.trim() in {}) {
      // never reached — placeholder for completeness
      out.push({ italic: false, text: ' ' + t });
    } else {
      out.push({ italic: false, text: ' ' + t });
    }
  }
  return out;
}

const segments = renderName(plant.scientific_name);
const gbifUrl  = plant.gbif_taxon_key
  ? `https://www.gbif.org/species/${plant.gbif_taxon_key}`
  : null;
const usdaUrl  = `https://plants.usda.gov/plant-profile/${plant.usda_symbol}`;
const itisUrl  = plant.itis_tsn
  ? `https://www.itis.gov/servlet/SingleRpt/SingleRpt?search_topic=TSN&search_value=${plant.itis_tsn}`
  : null;
---

<section aria-labelledby="plant-name" class="pt-10 pb-8">
  <p class="label flex items-baseline gap-3 mb-5">
    <span>§1</span>
    <span>Plant</span>
  </p>

  <h1 id="plant-name" class="font-serif text-3xl sm:text-4xl lg:text-5xl leading-none tracking-tight text-ink">
    <span class="sci">
      {segments.map(s => s.italic ? <i>{s.text}</i> : <span>{s.text}</span>)}
    </span>
  </h1>

  <p class="mt-3 font-sans text-lg text-ink-2 flex flex-wrap items-baseline gap-x-3 gap-y-1">
    {plant.common_name && (<>
      <span class="italic text-ink-3">vernacular</span>
      <span>{plant.common_name}</span>
    </>)}
    <span class="text-ink-3">
      &mdash; {plant.rank.toLowerCase()}
      {plant.family && (<> &middot; <span class="sci">{plant.family.split(' ')[0]}</span></>)}
    </span>
  </p>

  <hr class="rule mt-7" />

  <dl class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-3 text-sm">
    <div>
      <dt class="label">USDA</dt>
      <dd class="mt-1">
        <a href={usdaUrl} target="_blank" rel="noreferrer" class="mono link-hover">{plant.usda_symbol}</a>
      </dd>
    </div>
    {plant.gbif_taxon_key && (
      <div>
        <dt class="label">GBIF</dt>
        <dd class="mt-1">
          <a href={gbifUrl!} target="_blank" rel="noreferrer" class="mono link-hover">{plant.gbif_taxon_key}</a>
          {plant.gbif_match_status === 'SYNONYM' && (
            <span class="ml-1 text-xs text-ink-3 italic">syn.</span>
          )}
        </dd>
      </div>
    )}
    {plant.itis_tsn && (
      <div>
        <dt class="label">ITIS</dt>
        <dd class="mt-1"><a href={itisUrl!} target="_blank" rel="noreferrer" class="mono link-hover">{plant.itis_tsn}</a></dd>
      </div>
    )}
    <div>
      <dt class="label">Rank</dt>
      <dd class="mt-1 font-serif italic">{plant.rank.toLowerCase()}</dd>
    </div>
  </dl>
</section>
