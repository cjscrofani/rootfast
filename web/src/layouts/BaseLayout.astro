---
import '@/styles/global.css';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';

export interface Props {
  title?: string;
  description?: string;
  noFooter?: boolean;
  /** Override the OG type, defaults to "website". Use "article" for plant/species pages. */
  ogType?: 'website' | 'article';
  /** Mark a page as non-indexable (search results, etc.). */
  noindex?: boolean;
  /** Absolute URL of a preview image for social shares (e.g. a plant photo). */
  ogImage?: string;
  /** Alt text describing ogImage. */
  ogImageAlt?: string;
}

const {
  title = 'rootfast — a digital herbarium',
  description = 'Native plant data for the United States. Free, public-domain, fully queryable. 27,665 taxa with USDA hardiness zones and iNaturalist photos.',
  noFooter = false,
  ogType = 'website',
  noindex = false,
  ogImage,
  ogImageAlt,
} = Astro.props;

// Astro.site is set in astro.config.mjs; fall back to the production origin so
// canonical/OG URLs still render correctly in `astro dev` previews.
const siteOrigin = (Astro.site ?? new URL('https://rootfast.org')).origin;
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FAF6EE" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="rootfast" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

    <!-- Twitter -->
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <slot name="head" />
  </head>
  <body>
    <div class="relative z-10 flex min-h-screen flex-col">
      <SiteHeader />
      <main class="flex-1">
        <slot />
      </main>
      {!noFooter && <SiteFooter />}
    </div>
  </body>
</html>
