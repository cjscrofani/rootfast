---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — rootfast"
  description="Get in touch about rootfast: data corrections, API questions, collaboration."
>
  <article class="max-w-content mx-auto px-6 lg:px-10">
    <p class="pt-6 text-xs text-ink-3">
      <a href="/" class="link-hover">Index</a>
      <span class="mx-2">/</span>
      <span class="text-ink-2">Contact</span>
    </p>

    <header class="pt-10 pb-8">
      <p class="label flex items-baseline gap-3">
        <span aria-hidden="true">⚘</span>
        <span>Get in touch</span>
      </p>
      <h1 class="mt-5 font-serif text-4xl sm:text-5xl lg:text-6xl leading-none text-ink">
        Contact
      </h1>
      <p class="mt-4 font-serif text-xl italic text-ink-2 max-w-prose">
        Data corrections, missing species, API problems, partnership ideas,
        or just to say hello — send a note.
      </p>
    </header>

    <hr class="rule-strong" />

    <section class="py-10 grid grid-cols-1 lg:grid-cols-12 gap-12">
      <div class="lg:col-span-7">
        <form data-gdws-form data-siteid="rootfast" class="rf-contact">
          <div class="field-row">
            <label for="contact-name" class="label">Name</label>
            <input id="contact-name" name="name" type="text" required maxlength="200"
                   autocomplete="name" />
          </div>

          <div class="field-row">
            <label for="contact-email" class="label">Email</label>
            <input id="contact-email" name="email" type="email" required maxlength="320"
                   autocomplete="email" />
          </div>

          <div class="field-row">
            <label for="contact-message" class="label">Message</label>
            <textarea id="contact-message" name="message" required maxlength="10000"
                      rows="8"></textarea>
          </div>

          <!-- Honeypot — must stay hidden + empty. -->
          <input name="_hp" tabindex="-1" autocomplete="off" aria-hidden="true"
                 style="position:absolute;left:-9999px;opacity:0;pointer-events:none" />

          <!-- Cloudflare Turnstile (CAPTCHA replacement). -->
          <div class="cf-turnstile mt-6" data-sitekey="0x4AAAAAADTP-Tkpac69wOhv"
               data-theme="light"></div>

          <div class="mt-6">
            <button type="submit" class="btn btn-native">Send message</button>
          </div>

          <div data-gdws-status aria-live="polite" role="status"
               class="rf-status mt-5"></div>
        </form>

        <noscript>
          <p class="mt-8 text-sm text-ink-2 italic">
            This form requires JavaScript. Please email
            <a href="mailto:cj@gdws.co" class="link-hover text-ink">cj@gdws.co</a>
            directly.
          </p>
        </noscript>
      </div>

      <aside class="lg:col-span-5 lg:pl-10 lg:border-l lg:border-rule">
        <p class="label">Data corrections</p>
        <p class="mt-3 text-sm text-ink-2 leading-relaxed">
          Rootfast republishes federal data (USDA PLANTS) and open taxonomic
          data (GBIF). If a record looks wrong here, please first verify against
          <a href="https://plants.usda.gov" target="_blank" rel="noreferrer" class="link-hover text-ink">plants.usda.gov</a>
          — if the issue exists upstream, the fix needs to land there first.
          For rendering or join bugs that are ours, send a message with the
          USDA symbol and a description.
        </p>
      </aside>
    </section>
  </article>

  <!-- GDWS form mailer scripts -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script src="https://forms.golddustweb.com/client.js" defer></script>

  <style is:global>
    .rf-contact .field-row {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      margin-top: 1.25rem;
    }
    .rf-contact .field-row:first-of-type { margin-top: 0; }
    .rf-contact input[type="text"],
    .rf-contact input[type="email"],
    .rf-contact textarea {
      font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
      font-size: 1rem;
      color: var(--rf-ink);
      background: var(--rf-paper);
      border: 1px solid var(--rf-rule-strong);
      padding: 0.75rem 0.9rem;
      width: 100%;
      transition: border-color 120ms ease, background 120ms ease;
    }
    .rf-contact input[type="text"]:focus,
    .rf-contact input[type="email"]:focus,
    .rf-contact textarea:focus {
      outline: none;
      border-color: var(--rf-native);
      background: var(--rf-surface);
    }
    .rf-contact textarea {
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 1.05rem;
      resize: vertical;
      min-height: 8rem;
    }
    .rf-contact button[type="submit"][disabled] {
      opacity: 0.55;
      cursor: wait;
    }

    /* Status states from the mailer's client.js */
    .rf-status:empty { display: none; }
    .rf-status {
      padding: 0.75rem 1rem;
      border: 1px solid var(--rf-rule-strong);
      font-size: 0.9rem;
      font-family: 'Atkinson Hyperlegible', system-ui, sans-serif;
    }
    .rf-status[data-state="ok"] {
      color: var(--rf-native);
      background: var(--rf-native-soft);
      border-color: var(--rf-native);
    }
    .rf-status[data-state="error"] {
      color: var(--rf-introduced);
      background: var(--rf-introduced-soft);
      border-color: var(--rf-introduced);
    }
  </style>
</BaseLayout>
