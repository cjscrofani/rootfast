---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { api, type CountyPhotoCoverageRow } from '@/lib/api';

import countySvg from '../../../public/usa-counties.svg?raw';

let counties: CountyPhotoCoverageRow[] = [];
let error: string | null = null;
try {
  const r = await api.countiesPhotoCoverage();
  counties = r.counties;
} catch {
  error = 'Could not load photo-coverage data right now.';
}

interface Bin { label: string; min: number; max: number; color: string; }
// Photo coverage is dense at the high end (most counties are 90 %+ today), so
// the binning emphasises the long tail.
const BINS: Bin[] = [
  { label: 'no taxa recorded', min: -1,  max: -1,   color: '#EDE5D2' },
  { label: '0 %',              min:  0,   max: 0,    color: '#E0CFCB' },
  { label: '1–49 %',           min:  0.1, max: 49,   color: '#D3A6A6' },
  { label: '50–69 %',          min:  50,  max: 69.9, color: '#D89270' },
  { label: '70–84 %',          min:  70,  max: 84.9, color: '#E0B86C' },
  { label: '85–94 %',          min:  85,  max: 94.9, color: '#C9CC73' },
  { label: '95–99 %',          min:  95,  max: 99.9, color: '#8BBA73' },
  { label: '100 %',            min: 100,  max: 100,  color: '#3F8367' },
];

const binFor = (c: CountyPhotoCoverageRow): Bin => {
  if (c.taxa_count === 0) return BINS[0];
  return BINS.find(b => c.photo_pct >= b.min && c.photo_pct <= b.max) ?? BINS[2];
};

const cssRules = counties
  .map(c => `#c${c.county_fips}{fill:${binFor(c).color};}`)
  .join('');

const wallCss = `#counties path{stroke:rgba(26,24,21,0.20);stroke-width:0.25;}`;

const hoverPayload = JSON.stringify(
  counties.map(c => ({ f: c.county_fips, m: c.county_name, s: c.state_code, p: c.photo_pct, t: c.taxa_count, c: c.photo_count }))
);

const binCounts = BINS.map(bin => ({
  bin,
  count: counties.filter(c => binFor(c) === bin).length,
}));

const overall = (() => {
  const totalTaxa = counties.reduce((n, c) => n + c.taxa_count, 0);
  const totalPhoto = counties.reduce((n, c) => n + c.photo_count, 0);
  return totalTaxa > 0 ? (totalPhoto / totalTaxa) * 100 : 0;
})();
---

<BaseLayout
  title="Photo coverage by county — rootfast"
  description="Every US county coloured by the share of its recorded taxa that have an iNaturalist photo."
>
  <article class="max-w-content mx-auto px-6 lg:px-10">
    <p class="pt-6 text-xs text-ink-3">
      <a href="/explore" class="link-hover">Explore</a>
      <span class="mx-2">/</span>
      <span class="text-ink-2">Hardiness &amp; climate</span>
      <span class="mx-2">/</span>
      <span class="font-serif italic text-ink-2">Photo coverage by county</span>
    </p>

    <header class="pt-10 pb-8">
      <p class="label flex items-baseline gap-3">
        <span aria-hidden="true">⚘</span>
        <span>Hardiness &amp; climate</span>
      </p>
      <h1 class="mt-5 font-serif text-4xl sm:text-5xl lg:text-6xl leading-none text-ink">
        Photo coverage by county
      </h1>
      <p class="mt-4 max-w-prose font-serif text-lg italic text-ink-2 leading-relaxed">
        An honest look at the catalogue's visual coverage. Each county is coloured
        by the share of its recorded taxa that have an iNaturalist photo on file.
        Deep greens are well-illustrated; warmer hues are sparser.
      </p>

      <hr class="rule mt-7" />

      <dl class="mt-5 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-3 text-sm">
        <div>
          <dt class="label">Counties</dt>
          <dd class="mt-1 mono">{counties.length.toLocaleString('en-US')}</dd>
        </div>
        <div>
          <dt class="label">Overall coverage</dt>
          <dd class="mt-1 mono">{overall.toFixed(1)} %</dd>
        </div>
        <div>
          <dt class="label">Source</dt>
          <dd class="mt-1 mono text-ink-3">iNaturalist</dd>
        </div>
        <div>
          <dt class="label">API</dt>
          <dd class="mt-1 mono">
            <a class="link-hover" href="/docs#listCountyPhotoCoverage">/v1/counties/photo-coverage</a>
          </dd>
        </div>
      </dl>
    </header>

    <hr class="rule-strong" />

    {error && (
      <p class="py-10 mono text-sm text-ink-3 italic">{error}</p>
    )}

    {!error && counties.length > 0 && (
      <section class="py-7">
        <div class="rf-pcmap-card border border-rule bg-paper">
          <div
            class="rf-map-wrap"
            data-rf-pcmap
            data-counties={hoverPayload}
            set:html={countySvg}
          />

          <div class="rf-pcmap-legend">
            <div class="flex items-baseline justify-between gap-4 mb-3">
              <p class="label">Legend</p>
              <span class="text-xs text-ink-3 italic">Hover a county for detail.</span>
            </div>
            <div class="rf-pcmap-hover mono text-xs text-ink-2 mb-3" aria-live="polite" hidden></div>
            <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2 text-sm">
              {binCounts.map(({ bin, count }) => (
                <li class="flex items-center gap-3 border border-rule bg-paper px-3 py-2">
                  <span
                    class="inline-block w-4 h-4 border border-rule shrink-0"
                    style={`background:${bin.color}`}
                    aria-hidden="true"
                  ></span>
                  <span class="font-serif text-sm text-ink leading-none">{bin.label}</span>
                  <span class="ml-auto text-xs text-ink-3 mono">{count.toLocaleString('en-US')}</span>
                </li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-ink-3 italic">
              Counties with no recorded taxa at all (territories without ingested
              distribution data, mostly) get the pale base swatch.
            </p>
          </div>
        </div>
      </section>
    )}
  </article>

  <style set:html={`${wallCss}${cssRules}`} is:global />

  <style is:global>
    .rf-map-wrap svg { display: block; width: 100%; height: auto; max-height: 80vh; }
    .rf-map-wrap svg path { fill: #faf6ee; transition: fill 80ms ease; }
    .rf-map-wrap svg path:hover { fill-opacity: 0.7; }
    .rf-pcmap-legend { padding: 0.85rem 1rem 1rem; border-top: 1px solid var(--rf-rule); }
    .rf-pcmap-hover { min-height: 1.1rem; }
    .rf-pcmap-hover[hidden] { display: block !important; visibility: hidden; }
  </style>

  <script>
    type HoverRow = { f: string; m: string; s: string; p: number; t: number; c: number };

    for (const root of document.querySelectorAll<HTMLElement>('[data-rf-pcmap]')) {
      let rows: HoverRow[] = [];
      try { rows = JSON.parse(root.dataset.counties || '[]'); } catch { rows = []; }
      const byFips = new Map<string, HoverRow>();
      for (const r of rows) byFips.set(r.f, r);

      const svg = root.querySelector<SVGSVGElement>('svg');
      const hoverEl = document.querySelector<HTMLDivElement>('.rf-pcmap-hover');
      if (!svg || !hoverEl) continue;

      svg.addEventListener('mouseover', (e) => {
        const t = e.target as Element;
        if (!(t instanceof SVGPathElement)) return;
        const id = t.id;
        if (!id || !id.startsWith('c')) return;
        const fips = id.slice(1);
        const hit = byFips.get(fips);
        hoverEl.hidden = false;
        if (hit) {
          hoverEl.textContent =
            `${hit.m} County, ${hit.s} · FIPS ${fips} · ${hit.c.toLocaleString('en-US')} / ${hit.t.toLocaleString('en-US')} taxa with photos (${hit.p.toFixed(1)}%)`;
        } else {
          hoverEl.textContent = `FIPS ${fips} · no record`;
        }
      });
      svg.addEventListener('mouseleave', () => {
        hoverEl.hidden = true;
        hoverEl.textContent = '';
      });
    }
  </script>
</BaseLayout>
